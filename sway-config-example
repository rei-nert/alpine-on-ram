# Alternative: swaybar (built-in, lighter)
bar {
    position top
    height 28
    font pango:DejaVu Sans Mono 9
    colors {
        background #1e1e2e
        statusline #cdd6f4
        separator #313244
        focused_workspace  #89b4fa #89b4fa #1e1e2e
        active_workspace   #313244 #313244 #cdd6f4
        inactive_workspace #1e1e2e #1e1e2e #6c7086
        urgent_workspace   #f38ba8 #f38ba8 #1e1e2e
    }
    status_command while date '+ %Y-%m-%d %H:%M '; do sleep 1; done
    workspace_buttons yes
    binding_mode_indicator yes
}

# Input configuration
input type:keyboard {
    xkb_layout us
    xkb_variant dvorak  # Change to your layout
    xkb_options caps:escape,compose:ralt
    repeat_rate 35
    repeat_delay 250
}

input type:touchpad {
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
    dwt enabled
    accel_profile flat
}

# Output configuration (adjust for your monitor)
# output eDP-1 resolution 1920x1080 position 0,0 scale 1
# output HDMI-A-1 resolution 2560x1440 position 1920,0 scale 1

# Idle management (swayidle)
exec swayidle -w \
    timeout 300 'swaylock -f -c 000000' \
    timeout 600 'wlopm --off *' \
    resume 'wlopm --on *' \
    before-sleep 'swaylock -f -c 000000'

# Autostart applications
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP 2>/dev/null || true

# Polkit agent (for GUI auth)
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# Clipboard manager (wl-clipboard + wl-clip-persist)
# exec wl-paste --watch cliphist store

# NetworkManager applet (if using NM)
# exec nm-applet --indicator

# Waybar (if installed instead of swaybar)
# exec waybar

# Foot server (faster terminal startup)
exec foot --server

# Environment variables
env {
    EDITOR=nvim
    VISUAL=nvim
    BROWSER=firefox
    TERMINAL=foot
    MOZ_ENABLE_WAYLAND=1
    QT_QPA_PLATFORM=wayland
    SDL_VIDEODRIVER=wayland
    _JAVA_AWT_WM_NONREPARENTING=1
}

# Include additional configs from ~/.config/sway/config.d/
include ~/.config/sway/config.d/*